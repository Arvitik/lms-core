# Copy to .env.docker and adjust values if needed
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=lms
DB_USERNAME=root
DB_PASSWORD=root

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

# Start with 7.4 during first upgrade iterations if needed,
# then switch to 8.3 when compatibility fixes are complete.
# PHP_IMAGE_TAG=7.4-fpm
PHP_IMAGE_TAG=8.3-fpm
